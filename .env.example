# Copy to .env and fill in. Never commit the real .env.

# --- Tinker API ---
# Obtain from the Tinker console. Required for live training/sampling.
TINKER_API_KEY=

# --- Backend service ---
TF_HOST=0.0.0.0
TF_PORT=8000
TF_LOG_LEVEL=INFO
TF_LOG_JSON=false

# Directory where run metadata, checkpoints pointers, and job state live.
TF_ARTIFACTS_DIR=./runs

# Default base model (must exist in the open-weight registry, see models/registry.py).
# Tinker's own open-weight flagship is thinkingmachines/Inkling; Qwen3-8B is a
# small, practical default for local/dry-run work.
TF_DEFAULT_BASE_MODEL=Qwen/Qwen3-8B

# --- Weights & Biases (optional metrics logging) ---
# Set TF_WANDB_PROJECT to enable W&B (requires `pip install wandb`).
TF_WANDB_PROJECT=
TF_WANDB_ENTITY=
TF_WANDB_MODE=online

# Run the API without a live Tinker connection (uses an in-process fake backend).
# Useful for local development, demos, and CI. Set to false for real training.
TF_DRY_RUN=true

# Max concurrent training jobs the worker will run.
TF_MAX_CONCURRENT_JOBS=2
